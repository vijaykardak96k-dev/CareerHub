# Local development (backend run with `mvn spring-boot:run`, frontend with `npm run dev`).
# Copy to .env and adjust. Never commit the real .env file.

SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=careerhub
DB_USERNAME=careerhub
DB_PASSWORD=careerhub

# Must be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
JWT_EXPIRATION=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173
FILE_STORAGE_PATH=./storage

# Consumed by the frontend container entrypoint. For `npm run dev` the browser
# reads frontend/public/config.js instead.
API_BASE_URL=http://localhost:8080/api/v1

SEED_DEMO_DATA=true
SEED_PASSWORD=Password@123
