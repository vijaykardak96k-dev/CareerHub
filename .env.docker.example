# Used by docker-compose. Copy to .env next to docker-compose.yml.

DB_NAME=careerhub
DB_USERNAME=careerhub
DB_PASSWORD=change-this-password

# DB_HOST is set to the compose service name inside docker-compose.yml.
DB_PORT=5432

JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
JWT_EXPIRATION=86400000

# The browser, not the backend container, calls this URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8080/api/v1

FRONTEND_PORT=3000
BACKEND_PORT=8080

SEED_DEMO_DATA=true
SEED_PASSWORD=Password@123
