# Production template (EC2 or Kubernetes). Replace every placeholder.
# Real values belong in a Kubernetes Secret or an EC2 .env file with mode 600,
# never in version control.

SERVER_PORT=8080

# On EC2 with docker-compose this stays as the compose service name so that
# Postgres is never exposed to the internet.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=careerhub
DB_USERNAME=careerhub_prod
DB_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRATION=86400000

# Comma separated. Must match the origin the browser loads the frontend from.
CORS_ALLOWED_ORIGINS=https://careerhub.example.com

FILE_STORAGE_PATH=/app/storage

# Same origin as the frontend when Nginx or an Ingress proxies /api.
API_BASE_URL=https://careerhub.example.com/api/v1

# Turn the demo data off for a real deployment.
SEED_DEMO_DATA=false
